\PYG{c+c1}{\PYGZsh{} \PYGZlt{}h3 style=\PYGZdq{}line\PYGZhy{}height:200\PYGZpc{};font\PYGZhy{}family:\PYGZsq{}Vazirmatn\PYGZsq{},Tahoma,\PYGZsq{}Segoe UI\PYGZsq{},system\PYGZhy{}ui,Arial,sans\PYGZhy{}serif;color:\PYGZsh{}EF4056\PYGZdq{}\PYGZgt{}3. Positional encoding\PYGZlt{}/h3\PYGZgt{}}
