    \PYG{n}{q}\PYG{p}{,} \PYG{n}{k}\PYG{p}{,} \PYG{n}{v} \PYG{o}{=} \PYG{n}{x} \PYG{o}{@} \PYG{n}{Wq}\PYG{p}{,} \PYG{n}{x} \PYG{o}{@} \PYG{n}{Wk}\PYG{p}{,} \PYG{n}{x} \PYG{o}{@} \PYG{n}{Wv}
