    \PYG{n}{train\PYGZus{}loss\PYGZus{}history}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{train\PYGZus{}loss}\PYG{p}{)}

    \PYG{n}{model}\PYG{o}{.}\PYG{n}{eval}\PYG{p}{()}
