\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}visualize some samples from dataset to see what kind of data we have\PYGZdq{}\PYGZdq{}\PYGZdq{}}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{visualize\PYGZus{}dataset\PYGZus{}samples}\PYG{p}{(}\PYG{n}{train\PYGZus{}set}\PYG{p}{,} \PYG{n}{val\PYGZus{}set}\PYG{p}{,} \PYG{n}{test\PYGZus{}set}\PYG{p}{):}
    \PYG{c+c1}{\PYGZsh{} 1. Combine datasets into a single list with a tracking tag}
    \PYG{c+c1}{\PYGZsh{} Each item in the pool is a tuple: (image\PYGZus{}tensor, label, split\PYGZus{}tag)}
    \PYG{n}{pool} \PYG{o}{=} \PYG{p}{[]}
    \PYG{n}{pool}\PYG{o}{.}\PYG{n}{extend}\PYG{p}{([(}\PYG{n}{img}\PYG{p}{,} \PYG{n}{lbl}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}Train\PYGZdq{}}\PYG{p}{)} \PYG{k}{for} \PYG{n}{img}\PYG{p}{,} \PYG{n}{lbl} \PYG{o+ow}{in} \PYG{n}{train\PYGZus{}set}\PYG{p}{])}
    \PYG{n}{pool}\PYG{o}{.}\PYG{n}{extend}\PYG{p}{([(}\PYG{n}{img}\PYG{p}{,} \PYG{n}{lbl}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}Val\PYGZdq{}}\PYG{p}{)} \PYG{k}{for} \PYG{n}{img}\PYG{p}{,} \PYG{n}{lbl} \PYG{o+ow}{in} \PYG{n}{val\PYGZus{}set}\PYG{p}{])}
    \PYG{n}{pool}\PYG{o}{.}\PYG{n}{extend}\PYG{p}{([(}\PYG{n}{img}\PYG{p}{,} \PYG{n}{lbl}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}Test\PYGZdq{}}\PYG{p}{)} \PYG{k}{for} \PYG{n}{img}\PYG{p}{,} \PYG{n}{lbl} \PYG{o+ow}{in} \PYG{n}{test\PYGZus{}set}\PYG{p}{])}

    \PYG{c+c1}{\PYGZsh{} 2. Randomly select 25 unique samples for our 5x5 grid}
    \PYG{k}{if} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{pool}\PYG{p}{)} \PYG{o}{\PYGZlt{}} \PYG{l+m+mi}{25}\PYG{p}{:}
        \PYG{k}{raise} \PYG{n+ne}{ValueError}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Not enough images in the dataset to create a 5x5 grid.\PYGZdq{}}\PYG{p}{)}
    \PYG{n}{samples} \PYG{o}{=} \PYG{n}{random}\PYG{o}{.}\PYG{n}{sample}\PYG{p}{(}\PYG{n}{pool}\PYG{p}{,} \PYG{l+m+mi}{25}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 3. Class names for BreastMNIST: 0 is \PYGZsq{}benign\PYGZsq{} (normal/benign), 1 is \PYGZsq{}malignant\PYGZsq{}}
    \PYG{c+c1}{\PYGZsh{} For BreastMNIST, 0 = benign, 1 = malignant}
    \PYG{n}{class\PYGZus{}names} \PYG{o}{=} \PYG{p}{\PYGZob{}}\PYG{l+m+mi}{0}\PYG{p}{:} \PYG{l+s+s2}{\PYGZdq{}Benign/Normal\PYGZdq{}}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{:} \PYG{l+s+s2}{\PYGZdq{}Malignant\PYGZdq{}}\PYG{p}{\PYGZcb{}}

    \PYG{c+c1}{\PYGZsh{} 4. Initialize the 5x5 matplotlib figure}
    \PYG{n}{fig}\PYG{p}{,} \PYG{n}{axes} \PYG{o}{=} \PYG{n}{plt}\PYG{o}{.}\PYG{n}{subplots}\PYG{p}{(}\PYG{l+m+mi}{5}\PYG{p}{,} \PYG{l+m+mi}{5}\PYG{p}{,} \PYG{n}{figsize}\PYG{o}{=}\PYG{p}{(}\PYG{l+m+mi}{15}\PYG{p}{,} \PYG{l+m+mi}{15}\PYG{p}{))}
    \PYG{n}{axes} \PYG{o}{=} \PYG{n}{axes}\PYG{o}{.}\PYG{n}{flatten}\PYG{p}{()} \PYG{c+c1}{\PYGZsh{} Flatten 2D array of axes to 1D for easy iteration}

    \PYG{k}{for} \PYG{n}{i}\PYG{p}{,} \PYG{p}{(}\PYG{n}{img\PYGZus{}tensor}\PYG{p}{,} \PYG{n}{label}\PYG{p}{,} \PYG{n}{split}\PYG{p}{)} \PYG{o+ow}{in} \PYG{n+nb}{enumerate}\PYG{p}{(}\PYG{n}{samples}\PYG{p}{):}
        \PYG{n}{ax} \PYG{o}{=} \PYG{n}{axes}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}

        \PYG{c+c1}{\PYGZsh{} PyTorch tensors are (Channels, Height, Width)}
        \PYG{c+c1}{\PYGZsh{} Matplotlib expects (Height, Width, Channels) for plotting}
        \PYG{c+c1}{\PYGZsh{} We also need to un\PYGZhy{}normalize the image if we want to view it realistically,}
        \PYG{c+c1}{\PYGZsh{} but since we just want to inspect the structure, a basic permutation or clip works:}
        \PYG{n}{img\PYGZus{}array} \PYG{o}{=} \PYG{n}{img\PYGZus{}tensor}\PYG{o}{.}\PYG{n}{permute}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{2}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{)}\PYG{o}{.}\PYG{n}{numpy}\PYG{p}{()}
        \PYG{c+c1}{\PYGZsh{} Clip values to [0, 1] range to avoid matplotlib warnings if values went slightly out of bounds due to normalization}
        \PYG{n}{img\PYGZus{}array} \PYG{o}{=} \PYG{p}{(}\PYG{n}{img\PYGZus{}array} \PYG{o}{\PYGZhy{}} \PYG{n}{img\PYGZus{}array}\PYG{o}{.}\PYG{n}{min}\PYG{p}{())} \PYG{o}{/} \PYG{p}{(}\PYG{n}{img\PYGZus{}array}\PYG{o}{.}\PYG{n}{max}\PYG{p}{()} \PYG{o}{\PYGZhy{}} \PYG{n}{img\PYGZus{}array}\PYG{o}{.}\PYG{n}{min}\PYG{p}{()} \PYG{o}{+} \PYG{l+m+mf}{1e\PYGZhy{}8}\PYG{p}{)}



        \PYG{n}{ax}\PYG{o}{.}\PYG{n}{imshow}\PYG{p}{(}\PYG{n}{img\PYGZus{}array}\PYG{p}{)}
