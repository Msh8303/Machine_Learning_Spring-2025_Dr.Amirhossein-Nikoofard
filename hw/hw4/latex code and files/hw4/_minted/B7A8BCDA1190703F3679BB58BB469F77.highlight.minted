    \PYG{k}{for} \PYG{n}{epoch} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{epochs}\PYG{p}{):}

        \PYG{n}{epoch\PYGZus{}d\PYGZus{}loss} \PYG{o}{=} \PYG{l+m+mf}{0.0}
        \PYG{n}{epoch\PYGZus{}g\PYGZus{}loss} \PYG{o}{=} \PYG{l+m+mf}{0.0}

