\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{stable\PYGZus{}softmax}\PYG{p}{(}\PYG{n}{z}\PYG{p}{,} \PYG{n}{axis}\PYG{o}{=\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{):}
