            \PYG{n}{real\PYGZus{}imgs} \PYG{o}{=} \PYG{n}{real\PYGZus{}imgs}\PYG{o}{.}\PYG{n}{to}\PYG{p}{(}\PYG{n}{device}\PYG{p}{)}
