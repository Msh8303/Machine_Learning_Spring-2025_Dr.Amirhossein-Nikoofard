            \PYG{l+s+s1}{\PYGZsq{}d\PYGZus{}loss\PYGZsq{}}\PYG{p}{:} \PYG{n}{avg\PYGZus{}d\PYGZus{}loss}\PYG{p}{,}
            \PYG{l+s+s1}{\PYGZsq{}g\PYGZus{}loss\PYGZsq{}}\PYG{p}{:} \PYG{n}{avg\PYGZus{}g\PYGZus{}loss}\PYG{p}{,}
            \PYG{l+s+s1}{\PYGZsq{}balance\PYGZus{}score\PYGZsq{}}\PYG{p}{:} \PYG{n}{balance\PYGZus{}score}
        \PYG{p}{\PYGZcb{}}

        \PYG{c+c1}{\PYGZsh{} Save EVERY epoch}
        \PYG{n}{epoch\PYGZus{}path} \PYG{o}{=} \PYG{n}{os}\PYG{o}{.}\PYG{n}{path}\PYG{o}{.}\PYG{n}{join}\PYG{p}{(}\PYG{n}{save\PYGZus{}dir}\PYG{p}{,} \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}checkpoint\PYGZus{}epoch\PYGZus{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{epoch}\PYG{o}{+}\PYG{l+m+mi}{1}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{.pth\PYGZdq{}}\PYG{p}{)}
        \PYG{n}{torch}\PYG{o}{.}\PYG{n}{save}\PYG{p}{(}\PYG{n}{checkpoint\PYGZus{}data}\PYG{p}{,} \PYG{n}{epoch\PYGZus{}path}\PYG{p}{)}

