\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+se}{\PYGZbs{}n}\PYG{l+s+s2}{Generating }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{NUM\PYGZus{}SAMPLES\PYGZus{}PER\PYGZus{}CLASS}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{ samples for Class 0 (Benign)...\PYGZdq{}}\PYG{p}{)}
\PYG{n}{fake\PYGZus{}class\PYGZus{}0} \PYG{o}{=} \PYG{n}{generate\PYGZus{}class\PYGZus{}samples}\PYG{p}{(}\PYG{n}{eval\PYGZus{}generator}\PYG{p}{,} \PYG{n}{NUM\PYGZus{}SAMPLES\PYGZus{}PER\PYGZus{}CLASS}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{100}\PYG{p}{,} \PYG{n}{device}\PYG{p}{)}

\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Generating }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{NUM\PYGZus{}SAMPLES\PYGZus{}PER\PYGZus{}CLASS}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{ samples for Class 1 (Malignant)...\PYGZdq{}}\PYG{p}{)}
\PYG{n}{fake\PYGZus{}class\PYGZus{}1} \PYG{o}{=} \PYG{n}{generate\PYGZus{}class\PYGZus{}samples}\PYG{p}{(}\PYG{n}{eval\PYGZus{}generator}\PYG{p}{,} \PYG{n}{NUM\PYGZus{}SAMPLES\PYGZus{}PER\PYGZus{}CLASS}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{100}\PYG{p}{,} \PYG{n}{device}\PYG{p}{)}


\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{plot\PYGZus{}random\PYGZus{}images}\PYG{p}{(}\PYG{n}{fake\PYGZus{}0}\PYG{p}{,} \PYG{n}{fake\PYGZus{}1}\PYG{p}{,} \PYG{n}{model\PYGZus{}name}\PYG{p}{):}

