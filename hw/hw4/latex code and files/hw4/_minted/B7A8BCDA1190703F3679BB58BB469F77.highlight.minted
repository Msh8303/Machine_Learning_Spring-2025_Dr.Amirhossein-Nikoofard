\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{evaluate\PYGZus{}gan\PYGZus{}balance}\PYG{p}{(}\PYG{n}{gan}\PYG{p}{,} \PYG{n}{val\PYGZus{}loader}\PYG{p}{,} \PYG{n}{device}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Validation step: Calculates how close the GAN is to the ideal Nash Equilibrium.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{gan}\PYG{o}{.}\PYG{n}{generator}\PYG{o}{.}\PYG{n}{eval}\PYG{p}{()}
