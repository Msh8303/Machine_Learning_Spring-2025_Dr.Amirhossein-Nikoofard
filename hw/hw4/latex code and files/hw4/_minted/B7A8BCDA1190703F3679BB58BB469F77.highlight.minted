    \PYG{n}{idx\PYGZus{}1} \PYG{o}{=} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{randperm}\PYG{p}{(}\PYG{n}{fake\PYGZus{}1}\PYG{o}{.}\PYG{n}{size}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{))[:}\PYG{l+m+mi}{20}\PYG{p}{]}

