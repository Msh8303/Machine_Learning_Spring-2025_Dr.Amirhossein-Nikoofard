            \PYG{c+c1}{\PYGZsh{} Discriminator\PYGZsq{}s average prediction on REAL images}
            \PYG{n}{real\PYGZus{}preds} \PYG{o}{=} \PYG{n}{gan}\PYG{o}{.}\PYG{n}{discriminator}\PYG{p}{(}\PYG{n}{real\PYGZus{}imgs}\PYG{p}{,} \PYG{n}{labels}\PYG{p}{)}
            \PYG{n}{total\PYGZus{}real\PYGZus{}prob} \PYG{o}{+=} \PYG{n}{real\PYGZus{}preds}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{()}\PYG{o}{.}\PYG{n}{item}\PYG{p}{()}

            \PYG{c+c1}{\PYGZsh{} Discriminator\PYGZsq{}s average prediction on FAKE images}
            \PYG{n}{z} \PYG{o}{=} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{randn}\PYG{p}{(}\PYG{n}{batch\PYGZus{}size}\PYG{p}{,} \PYG{n}{gan}\PYG{o}{.}\PYG{n}{latent\PYGZus{}dim}\PYG{p}{,} \PYG{n}{device}\PYG{o}{=}\PYG{n}{device}\PYG{p}{)}
            \PYG{n}{fake\PYGZus{}imgs} \PYG{o}{=} \PYG{n}{gan}\PYG{o}{.}\PYG{n}{generator}\PYG{p}{(}\PYG{n}{z}\PYG{p}{,} \PYG{n}{labels}\PYG{p}{)}
            \PYG{n}{fake\PYGZus{}preds} \PYG{o}{=} \PYG{n}{gan}\PYG{o}{.}\PYG{n}{discriminator}\PYG{p}{(}\PYG{n}{fake\PYGZus{}imgs}\PYG{p}{,} \PYG{n}{labels}\PYG{p}{)}
            \PYG{n}{total\PYGZus{}fake\PYGZus{}prob} \PYG{o}{+=} \PYG{n}{fake\PYGZus{}preds}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{()}\PYG{o}{.}\PYG{n}{item}\PYG{p}{()}

            \PYG{n}{num\PYGZus{}batches} \PYG{o}{+=} \PYG{l+m+mi}{1}

    \PYG{n}{avg\PYGZus{}real\PYGZus{}prob} \PYG{o}{=} \PYG{n}{total\PYGZus{}real\PYGZus{}prob} \PYG{o}{/} \PYG{n}{num\PYGZus{}batches}
    \PYG{n}{avg\PYGZus{}fake\PYGZus{}prob} \PYG{o}{=} \PYG{n}{total\PYGZus{}fake\PYGZus{}prob} \PYG{o}{/} \PYG{n}{num\PYGZus{}batches}

    \PYG{c+c1}{\PYGZsh{} Ideal equilibrium is 0.5 for both. Lower score means closer to ideal (Best Model).}
    \PYG{n}{balance\PYGZus{}score} \PYG{o}{=} \PYG{n+nb}{abs}\PYG{p}{(}\PYG{n}{avg\PYGZus{}real\PYGZus{}prob} \PYG{o}{\PYGZhy{}} \PYG{l+m+mf}{0.5}\PYG{p}{)} \PYG{o}{+} \PYG{n+nb}{abs}\PYG{p}{(}\PYG{n}{avg\PYGZus{}fake\PYGZus{}prob} \PYG{o}{\PYGZhy{}} \PYG{l+m+mf}{0.5}\PYG{p}{)}

    \PYG{n}{gan}\PYG{o}{.}\PYG{n}{generator}\PYG{o}{.}\PYG{n}{train}\PYG{p}{()}
    \PYG{n}{gan}\PYG{o}{.}\PYG{n}{discriminator}\PYG{o}{.}\PYG{n}{train}\PYG{p}{()}

    \PYG{k}{return} \PYG{n}{avg\PYGZus{}real\PYGZus{}prob}\PYG{p}{,} \PYG{n}{avg\PYGZus{}fake\PYGZus{}prob}\PYG{p}{,} \PYG{n}{balance\PYGZus{}score}


\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{train\PYGZus{}cDCGAN}\PYG{p}{(}\PYG{n}{gan}\PYG{p}{,} \PYG{n}{train\PYGZus{}loader}\PYG{p}{,} \PYG{n}{val\PYGZus{}loader}\PYG{p}{,} \PYG{n}{epochs}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,} \PYG{n}{device}\PYG{p}{:} \PYG{n+nb}{str}\PYG{p}{):}

