            \PYG{n}{losses} \PYG{o}{=} \PYG{n}{gan}\PYG{o}{.}\PYG{n}{train\PYGZus{}step}\PYG{p}{(}\PYG{n}{real\PYGZus{}imgs}\PYG{p}{,} \PYG{n}{labels}\PYG{p}{)}

            \PYG{n}{epoch\PYGZus{}d\PYGZus{}loss} \PYG{o}{+=} \PYG{n}{losses}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}d\PYGZus{}loss\PYGZsq{}}\PYG{p}{]}
            \PYG{n}{epoch\PYGZus{}g\PYGZus{}loss} \PYG{o}{+=} \PYG{n}{losses}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}g\PYGZus{}loss\PYGZsq{}}\PYG{p}{]}

        \PYG{n}{avg\PYGZus{}d\PYGZus{}loss} \PYG{o}{=} \PYG{n}{epoch\PYGZus{}d\PYGZus{}loss} \PYG{o}{/} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{train\PYGZus{}loader}\PYG{p}{)}
        \PYG{n}{avg\PYGZus{}g\PYGZus{}loss} \PYG{o}{=} \PYG{n}{epoch\PYGZus{}g\PYGZus{}loss} \PYG{o}{/} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{train\PYGZus{}loader}\PYG{p}{)}

        \PYG{n}{real\PYGZus{}prob}\PYG{p}{,} \PYG{n}{fake\PYGZus{}prob}\PYG{p}{,} \PYG{n}{balance\PYGZus{}score} \PYG{o}{=} \PYG{n}{evaluate\PYGZus{}gan\PYGZus{}balance}\PYG{p}{(}\PYG{n}{gan}\PYG{p}{,} \PYG{n}{val\PYGZus{}loader}\PYG{p}{,} \PYG{n}{device}\PYG{p}{)}

        \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Epoch [}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{epoch}\PYG{o}{+}\PYG{l+m+mi}{1}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{/}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{epochs}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{] | D Loss: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{avg\PYGZus{}d\PYGZus{}loss}\PYG{l+s+si}{:}\PYG{l+s+s2}{.4f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{ | G Loss: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{avg\PYGZus{}g\PYGZus{}loss}\PYG{l+s+si}{:}\PYG{l+s+s2}{.4f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}

        \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}  \PYGZhy{}\PYGZgt{} Val D(Real): }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{real\PYGZus{}prob}\PYG{l+s+si}{:}\PYG{l+s+s2}{.4f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{ | Val D(Fake): }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{fake\PYGZus{}prob}\PYG{l+s+si}{:}\PYG{l+s+s2}{.4f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{ | Balance Score: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{balance\PYGZus{}score}\PYG{l+s+si}{:}\PYG{l+s+s2}{.4f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}

        \PYG{n}{checkpoint\PYGZus{}data} \PYG{o}{=} \PYG{p}{\PYGZob{}}
            \PYG{l+s+s1}{\PYGZsq{}epoch\PYGZsq{}}\PYG{p}{:} \PYG{n}{epoch} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{p}{,}
