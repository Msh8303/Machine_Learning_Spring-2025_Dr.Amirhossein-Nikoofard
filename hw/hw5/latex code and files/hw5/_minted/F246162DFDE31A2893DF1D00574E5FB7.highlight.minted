\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{positional\PYGZus{}encoding}\PYG{p}{(}\PYG{n}{T}\PYG{p}{,} \PYG{n}{d}\PYG{p}{):}
    \PYG{c+c1}{\PYGZsh{} column vector of positions (T, 1)}
    \PYG{n}{pos} \PYG{o}{=} \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{arange}\PYG{p}{(}\PYG{n}{T}\PYG{p}{)[:,} \PYG{k+kc}{None}\PYG{p}{]}

    \PYG{c+c1}{\PYGZsh{} row vector of dimension indices (1, d)}
    \PYG{n}{i} \PYG{o}{=} \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{arange}\PYG{p}{(}\PYG{n}{d}\PYG{p}{)[}\PYG{k+kc}{None}\PYG{p}{,} \PYG{p}{:]}

    \PYG{c+c1}{\PYGZsh{} compute angle rates}
    \PYG{n}{angle\PYGZus{}rates} \PYG{o}{=} \PYG{l+m+mf}{1.0} \PYG{o}{/} \PYG{p}{(}\PYG{l+m+mi}{10000} \PYG{o}{**} \PYG{p}{((}\PYG{l+m+mi}{2} \PYG{o}{*} \PYG{p}{(}\PYG{n}{i} \PYG{o}{//} \PYG{l+m+mi}{2}\PYG{p}{))} \PYG{o}{/} \PYG{n}{d}\PYG{p}{))}

    \PYG{c+c1}{\PYGZsh{} compute angles via broadcasting → shape (T, d)}
    \PYG{n}{angles} \PYG{o}{=} \PYG{n}{pos} \PYG{o}{*} \PYG{n}{angle\PYGZus{}rates}

    \PYG{c+c1}{\PYGZsh{} apply sin to even indices, cos to odd indices}
    \PYG{n}{pe} \PYG{o}{=} \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{where}\PYG{p}{(}\PYG{n}{i} \PYG{o}{\PYGZpc{}} \PYG{l+m+mi}{2} \PYG{o}{==} \PYG{l+m+mi}{0}\PYG{p}{,}
                   \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{sin}\PYG{p}{(}\PYG{n}{angles}\PYG{p}{),}
                   \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{cos}\PYG{p}{(}\PYG{n}{angles}\PYG{p}{))}

    \PYG{k}{return} \PYG{n}{pe}


