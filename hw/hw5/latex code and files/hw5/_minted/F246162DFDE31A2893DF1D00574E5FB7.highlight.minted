\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{causal\PYGZus{}mask}\PYG{p}{(}\PYG{n}{T}\PYG{p}{):}
    \PYG{c+c1}{\PYGZsh{} lower triangular matrix}
    \PYG{n}{mask} \PYG{o}{=} \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{tril}\PYG{p}{(}\PYG{n}{jnp}\PYG{o}{.}\PYG{n}{ones}\PYG{p}{((}\PYG{n}{T}\PYG{p}{,} \PYG{n}{T}\PYG{p}{),} \PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{bool}\PYG{p}{))}
    \PYG{k}{return} \PYG{n}{mask}


\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{scaled\PYGZus{}dot\PYGZus{}product\PYGZus{}attention}\PYG{p}{(}\PYG{n}{q}\PYG{p}{,} \PYG{n}{k}\PYG{p}{,} \PYG{n}{v}\PYG{p}{,} \PYG{n}{mask}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}

    \PYG{c+c1}{\PYGZsh{} dimension of head}
    \PYG{n}{d\PYGZus{}head} \PYG{o}{=} \PYG{n}{q}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{[}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]}

    \PYG{c+c1}{\PYGZsh{} compute attention scores}
    \PYG{n}{scores} \PYG{o}{=} \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{matmul}\PYG{p}{(}\PYG{n}{q}\PYG{p}{,} \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{swapaxes}\PYG{p}{(}\PYG{n}{k}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{2}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{))}

    \PYG{c+c1}{\PYGZsh{} scale}
    \PYG{n}{scores} \PYG{o}{=} \PYG{n}{scores} \PYG{o}{/} \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{n}{d\PYGZus{}head}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} apply mask if provided}
